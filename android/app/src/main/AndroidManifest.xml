<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Flutter puts INTERNET in the debug and profile manifests only, because
      the tool needs it for hot reload. It is NOT in a release build unless it
      is declared here — so an app that works perfectly under `flutter run`
      cannot open a single socket once it is installed from an APK, and every
      screen reports "no connection".

      ACCESS_NETWORK_STATE is what lets the platform tell "the phone is off the
      network" apart from "the server did not answer", which are two different
      sentences to show a driver at seven in the morning.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!--
      Where the bus is. Asked for by the DRIVER build only at runtime, and the
      one thing this platform could not do without it is most of what it was
      built for: a parent watching the bus approach, the nearest-stop ordering
      on the run screen, the geofences the school configured, and the ledger's
      answer to "where was the bus when that child was set down".

      Coarse is declared beside fine because Android 12 and later let a person
      grant only the approximate one, and an approximate position still places
      a bus on a street. The app treats a refusal as a refusal — it keeps
      working, sends nothing, and says so — rather than nagging.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!--
      The camera. The driver app cannot open a shift without a photograph of
      the crew member standing at the bus: shift-start refuses any asset id
      that is not a real file this person uploaded, so a handset with no way to
      take a picture cannot file the pre-trip walk-around, and without the
      walk-around the bus is not allowed to depart.

      Declared, and therefore ASKED FOR at the moment the driver taps "take the
      photo" — image_picker looks for exactly this line in the merged manifest
      and requests it at runtime when it finds it. Nothing else in the app opens
      a camera.

      No storage permission goes with it. The photograph is handed back through
      a file the plugin owns in the app's own cache directory; nothing here
      reads the gallery, and READ_EXTERNAL_STORAGE on a modern Android would be
      asking a driver for their whole photo library to take one picture.
    -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!--
      Used, not required. One codebase builds five apps from this manifest and
      only the driver's ever opens a camera, so a camera-less handset must
      still be able to install the parent app.
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <!-- The map credit links out to Mapbox and OpenStreetMap. Without this
             Android 11 and up hide every browser from the app, and the link
             silently does nothing. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
